# EFFV3 Verifiable Governed Agent Gateway — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# Terminal 3 ADK developer key.
# The ADK docs describe this as the key the SDK uses to authenticate as you.
T3N_API_KEY=your-terminal3-token-here

# Terminal 3 DID generated and linked to the developer key.
DID=did:t3n:your-did-here

# Backward-compatible alias. Prefer T3N_API_KEY.
TERMINAL3_API_KEY=

# Set to "true" to run in mock mode (no real crypto / T3 network calls)
T3_MOCK=false

# Optional legacy Terminal 3 HTTP API base URL for demo/check_t3n_api.py.
T3N_BASE_URL=https://staging.terminal3.io
