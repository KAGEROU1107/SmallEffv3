# EFFV3 Verifiable Governed Agent Gateway — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# Terminal 3 token API key.
# Used as x-api-token for documented Terminal 3 API calls.
T3N_API_KEY=your-terminal3-token-here

# Terminal 3 DID bound into action proofs and checked against GET /v1/did.
DID=did:t3n:your-did-here

# Backward-compatible alias. Prefer T3N_API_KEY.
TERMINAL3_API_KEY=

# Set to "true" to run in mock mode (no real crypto / T3 network calls)
T3_MOCK=false

# Defaults to https://staging.terminal3.io per current Terminal 3 API docs.
T3N_BASE_URL=https://staging.terminal3.io
