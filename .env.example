# EFFV3 Verifiable Governed Agent Gateway — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# Terminal 3 Agent Auth key (hex Ed25519 private key from T3 dashboard)
TERMINAL3_API_KEY=your-terminal3-hex-key-here

# Set to "true" to run in mock mode (no real crypto / T3 network calls)
T3_MOCK=false
